% V(4,9), depth-6 six-leaf reduced hard-instance constraints.
% Baseline solver/common.lp and solver/target_v.lp are not modified.
:- layer(L), not active(L).
:- depth(D), selected(D,I,J), I >= 5, J >= 5.
:- depth(D), 3 != #count { I,J : selected(D,I,J) }.
:- depth(D), not selected(D,1,6).
:- depth(D), not selected(D,2,3).
:- depth(D), not selected(D,4,5).
:- selected(5,1,6).
:- selected(5,2,3).
:- selected(5,4,5).

:- 3 != #count { I,J : selected(5,I,J) }.

% Tail category for B6_residual_L5eq3: p1_5__p6_9
:- not selected(5,1,5).
:- not selected(5,6,9).
